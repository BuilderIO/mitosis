{
  "name": "@builder.io/e2e-angular",
  "scripts": {
    "build": "yarn run copy-build && ng build && cpy dist/e2e-angular/index.html . --rename=404.html",
    "clean": "rimraf src dist",
    "copy-build": "cpy ../e2e-app/output/angular/src angular_src/app",
    "ng": "ng",
    "serve": "http-server dist/e2e-angular",
    "start": "yarn run copy-build && ng serve",
    "watch": "yarn run copy-build && ng build --watch --configuration development"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^19.2.23",
    "@angular/common": "^19.2.23",
    "@angular/compiler": "^19.2.23",
    "@angular/core": "^19.2.23",
    "@angular/forms": "^19.2.23",
    "@angular/platform-browser": "^19.2.23",
    "@angular/platform-browser-dynamic": "^19.2.23",
    "@builder.io/e2e-app": "workspace:*",
    "@builder.io/mitosis-cli": "workspace:*",
    "http-server": "^14.1.1",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^19.2.26",
    "@angular/cli": "~19.2.26",
    "@angular/compiler-cli": "^19.2.23",
    "cpy-cli": "5.0.0",
    "rimraf": "^3.0.2",
    "typescript": "5.8.3"
  }
}
